# Local development only. Copy to .env and replace the password before starting.
# Source .env in your shell before running Maven or the JAR; Java does not load it.
POSTGRES_DB=punttiurpo
POSTGRES_USER=punttiurpo
POSTGRES_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=54328
SERVER_PORT=8080

# Required BCrypt hashes; provision with the documented account setup command.
OWNER_PASSWORD_HASH=
DEMO_PASSWORD_HASH=
SESSION_COOKIE_SECURE=false
